  <version>0.1.0</version>
  <description>Launch files that connect MAVROS to a Pixhawk 2.4.8 (ArduPilot) or to ArduPilot SITL.</description>
  <maintainer email="maintainer@example.com">robodrone</maintainer>
  <license>TODO: choose a license</license>

  <exec_depend>launch</exec_depend>
